{
  "expo": {
    "name": "SlitzCut",
    "slug": "slitzcut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slitzcut",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.v1mtw13psu2nv6ka9q9kx",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Videolarınızı kamera rulosuna kaydetmek için",
        "NSMicrophoneUsageDescription": "Video kaydı için mikrofon erişimi",
        "NSCameraUsageDescription": "Video çekimi için kamera erişimi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.v1mtw13psu2nv6ka9q9kx",
      "permissions": [
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-media-library",
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}